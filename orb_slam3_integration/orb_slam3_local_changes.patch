+# orb_capi: minimal C-linkage wrapper around System (Stereo-Inertial), for
+# embedding a live ORB-SLAM3 session inside another process (e.g. driven via
+# Python ctypes - see hardware_project/camera/orbslam_bridge.py). Unconditional
+# (no realsense2 dependency, unlike the Examples below) - mirrors how
+# open_vins/ov_msckf builds its own ov_capi target the same way.
+add_library(orb_capi SHARED src/orb_capi.cc include/orb_capi.h)
+target_link_libraries(orb_capi ${PROJECT_NAME})
+
 # If RealSense SDK is found the library is added and its examples compiled
 if(realsense2_FOUND)
     include_directories(${PROJECT_NAME}
