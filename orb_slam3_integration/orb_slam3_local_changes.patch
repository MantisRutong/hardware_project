diff --git a/include/System.h b/include/System.h
index 872c86e..26c9b2b 100644
--- a/include/System.h
+++ b/include/System.h
@@ -177,6 +177,23 @@ public:
     std::vector<MapPoint*> GetTrackedMapPoints();
     std::vector<cv::KeyPoint> GetTrackedKeyPointsUn();
 
+    // Local addition (not upstream, see orb_capi.cc): a counter that changes
+    // every time ORB-SLAM3 resets in a way that can move the active map's
+    // pose origin -- e.g. after "Not enough motion for initializing.
+    // Reseting..." or "IMU is not or recently initialized. Reseting active
+    // map..." during Stereo-Inertial tracking -- without that being visible
+    // through GetTrackingState() (which reports OK either way once tracking
+    // resumes on the reset map). Comparing this value across calls is how a
+    // caller detects "the poses before and after this frame are NOT in the
+    // same coordinate frame, don't treat them as continuous". Backed by
+    // Atlas::GetResetGeneration() rather than the active map's own ID
+    // (Map::GetId()) because live testing showed the common reset path
+    // (Tracking::ResetActiveMap(), Atlas::clearMap()) clears and
+    // re-initializes the SAME Map object in place -- its ID never changes
+    // even though the origin does -- see Atlas.h's doc comment for the
+    // full story.
+    long unsigned int GetMapEpoch();
+
     // For debugging
     double GetTimeFromIMUInit();
     bool isLost();
